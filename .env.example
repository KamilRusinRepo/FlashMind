DB_NAME=flashmind
DB_USERNAME=flashmind
DB_PASSWORD=replace_with_a_long_random_password

# Optional: creates an administrator at startup only when no ADMIN account exists.
# Set all three values together. Never commit real credentials.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# RabbitMQ: choose credentials manually before starting Compose.
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=flashmind
# Host ports; the backend always uses rabbitmq:5672 inside Docker.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Local test mailbox. SMTP is accessible inside Docker without authentication/TLS.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_UI_PORT=8025
MAIL_FROM=no-reply@flashmind.local
MAIL_VERIFICATION_URL=http://localhost:3000/verify-email
MAIL_PASSWORD_RESET_URL=http://localhost:3000/reset-password
